// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Test {
  id          Int    @id @default(autoincrement())
  name        String
  desctiption String
}

model idtables {
  seq    Int    @id @default(autoincrement())
  id_key String @unique @db.VarChar(100)
  id_val Int

  @@map("id_tables")
}

model users {
  seq                   Int                     @id @default(autoincrement())
  id                    String                  @unique @db.VarChar(100)
  nickname              String                  @db.VarChar(100)
  email                 String                  @unique @db.VarChar(100)
  oauths                oauths[]
  traing                training[]
  training_history      training_history[]
  user_training_program user_training_program[]
}

model oauths {
  seq      Int    @id @default(autoincrement())
  user_seq Int
  platform String @db.VarChar(100)
  identify String @db.VarChar(100)
  users    users  @relation(fields: [user_seq], references: [seq])
}

/// 운동 종목의 정규 코드, 표시명 및 분류 정보를 관리하는 마스터 테이블.
model training_category {
  /// 운동 종목 내부 PK.
  seq                   Int                         @id @default(autoincrement())
  /// API와 프로그램에서 사용하는 변경되지 않는 정규 코드. 예: BENCH_PRESS.
  training_name         String                      @unique @db.VarChar(100)
  /// 사용자 화면에 노출하는 운동 종목명.
  training_display_name String                      @db.VarChar(100)
  /// 운동 기구 유형. 현재 문자열이며 추후 training_type enum으로 전환한다.
  training_type         String                      @db.VarChar(100)
  /// 상체, 하체 등 운동 부위의 상위 분류.
  target_category       String                      @db.VarChar(100)
  /// 운동의 대표 타깃 근육. 다중 근육 지원 시 연결 테이블로 분리한다.
  target_muscle         String                      @db.VarChar(100)
  /// 이 종목을 목표 운동으로 포함하는 프로그램 구성 목록.
  program_exercises     training_program_exercise[] @relation("ProgramExerciseCategory")
  /// 이 종목의 1RM을 기준으로 중량을 추정하는 프로그램 운동 목록.
  referenced_program_exercises training_program_exercise[] @relation("ProgramExerciseOneRmReference")
  /// 이 종목으로 기록된 실제 수행 세트 목록.
  training_history      training_history[]
}

enum training_type {
  FREE_WEIGHT
  MACHINE
}

enum target_category {
  UPPER
  LOWER
}

enum target_muscle {
  CHEST
  UPPER_BACK
  LOWER_BACK
  DELTOID
  LOWER
}

/// 실제 운동 세션의 생성 출처.
enum training_mode {
  /// 프로그램에 속하지 않는 자유 운동.
  FREE
  /// 정규 프로그램 회차를 수행한 운동.
  PROGRAM
}

/// 사용자에게 배정된 프로그램의 진행 상태.
enum user_training_program_status {
  /// 현재 진행 중.
  ACTIVE
  /// 사용자에 의해 일시 중지됨.
  PAUSED
  /// 모든 필수 회차를 완료함.
  COMPLETED
  /// 완료 전에 종료함.
  CANCELLED
}

model onerm {
  seq           Int      @id @default(autoincrement())
  author        String   @db.VarChar(100)
  training_name String   @db.VarChar(100)
  /// 계산된 실제 1RM 값.
  weight        Decimal  @db.Decimal(5, 2)
  unit          String   @db.VarChar(10)
  /// 1RM 계산에 사용한 실제 수행 중량. null이면 레거시 기록이다.
  source_weight Decimal? @db.Decimal(5, 2)
  /// 1RM 계산에 사용한 반복 횟수. null이면 레거시 기록이다.
  source_reps   Int?
  createdAt     DateTime @default(now()) @db.Timestamp(0)

  @@index([author, training_name, createdAt])
}

/// 사용자가 실제로 수행한 한 번의 운동 세션. 자유 운동과 프로그램 운동을 모두 저장한다.
model training {
  /// 운동 세션 내부 PK.
  seq                   Int                    @id @default(autoincrement())
  /// 운동을 수행한 사용자 FK.
  user_seq              Int
  /// 자유 운동 또는 프로그램 운동 구분.
  mode                  training_mode          @default(FREE)
  /// 프로그램 운동일 때 사용자의 프로그램 진행 정보 FK.
  user_program_seq      Int?
  /// 프로그램 운동일 때 실제로 수행한 프로그램 회차 FK.
  program_day_seq       Int?
  /// 운동을 수행한 시각.
  training_date         DateTime               @default(dbgenerated("CURRENT_TIMESTAMP")) @db.DateTime(0)
  /// 운동을 수행한 사용자.
  users                 users                  @relation(fields: [user_seq], references: [seq])
  /// 이 세션과 연결된 사용자 프로그램. 자유 운동 또는 참조 삭제 시 null.
  user_training_program user_training_program? @relation(fields: [user_program_seq], references: [seq], onDelete: SetNull)
  /// 이 세션에서 수행한 프로그램 회차. 자유 운동 또는 참조 삭제 시 null.
  training_program_day  training_program_day?  @relation(fields: [program_day_seq], references: [seq], onDelete: SetNull)
  /// 이 운동 세션에 포함된 실제 수행 세트.
  training_history      training_history[]

  @@index([user_seq, training_date])
  @@index([mode, user_program_seq, training_date])
}

/// 운동 세션에서 실제로 수행한 한 세트를 저장하는 테이블.
model training_history {
  /// 수행 세트 내부 PK.
  seq                   Int                @id @default(autoincrement())
  /// 이 세트가 속한 운동 세션 FK.
  training_seq          Int
  /// 레거시 사용자 FK. 상위 training.user_seq로 대체 후 제거한다.
  user_seq              Int
  /// 수행한 정규 운동 종목 FK. 데이터 백필 전까지 null을 허용한다.
  training_category_seq Int?
  /// 수행 당시의 운동 종목명 스냅샷.
  name                  String             @db.VarChar(100)
  /// 실제 수행 중량.
  weight                Decimal            @db.Decimal()
  /// 중량 단위. 예: kg, lb.
  weight_unit           String             @db.VarChar(3)
  /// 실제 반복 횟수. 레거시 Decimal이며 최종적으로 Int로 변경한다.
  reps                  Decimal            @db.Decimal()
  /// 레거시 세트 순번. set_order 백필 후 제거한다.
  sets                  Decimal            @db.Decimal()
  /// 레거시 휴식 시간. rest_seconds 백필 후 제거한다.
  rest                  DateTime           @db.Time()
  /// 운동 세션 및 종목 내 1부터 시작하는 세트 순번.
  set_order             Int?
  /// 해당 세트 수행 후 휴식 시간(초).
  rest_seconds          Int?
  /// 이 세트가 속한 운동 세션.
  training              training           @relation(fields: [training_seq], references: [seq], onDelete: Cascade)
  /// 레거시 사용자 관계.
  users                 users              @relation(fields: [user_seq], references: [seq])
  /// 실제 수행한 정규 운동 종목.
  training_category     training_category? @relation(fields: [training_category_seq], references: [seq], onDelete: SetNull)

  @@index([training_seq, set_order])
  @@index([training_category_seq])
}

/// 사용자에게 제공하는 정규 운동 프로그램의 버전별 정의 테이블.
model training_program {
  /// 프로그램 버전 내부 PK.
  seq                   Int                     @id @default(autoincrement())
  /// 프로그램 버전 간 공유하는 정규 식별 코드.
  code                  String                  @db.VarChar(50)
  /// 사용자 화면에 노출하는 프로그램명.
  name                  String                  @db.VarChar(100)
  /// 프로그램의 목적, 대상 및 수행 방법 설명.
  description           String?                 @db.Text
  /// 같은 코드 안에서 증가하는 프로그램 버전.
  version               Int                     @default(1)
  /// 신규 사용자에게 선택 가능한 버전인지 여부.
  is_active             Boolean                 @default(true)
  /// 프로그램 버전 생성 시각.
  created_at            DateTime                @default(now()) @db.DateTime(0)
  /// 프로그램 버전 마지막 수정 시각.
  updated_at            DateTime                @updatedAt @db.DateTime(0)
  /// 이 프로그램을 구성하는 주차별/일차별 회차 목록.
  training_program_days training_program_day[]
  /// 이 프로그램 버전을 시작한 사용자 진행 목록.
  user_programs         user_training_program[]

  @@unique([code, version])
}

/// 정규 프로그램에서 특정 주차와 일차에 수행할 한 회차의 정의 테이블.
model training_program_day {
  /// 프로그램 회차 내부 PK.
  seq                        Int                         @id @default(autoincrement())
  /// 상위 프로그램 버전 FK.
  program_seq                Int
  /// 1부터 시작하는 프로그램 주차 순번.
  week_order                 Int
  /// 해당 주차 안에서 1부터 시작하는 일차 순번.
  day_order                  Int
  /// 사용자 화면에 노출하는 회차명. 예: 1주차 A.
  name                       String                      @db.VarChar(100)
  /// 이 회차가 속한 프로그램 버전.
  training_program           training_program            @relation(fields: [program_seq], references: [seq], onDelete: Cascade)
  /// 이 회차에 포함된 목표 운동 목록.
  training_program_exercises training_program_exercise[]
  /// 이 회차를 기반으로 실제 수행한 운동 세션 목록.
  trainings                  training[]

  @@unique([program_seq, week_order, day_order])
}

/// 프로그램 회차에 포함된 운동 종목과 목표 세트 조건을 정의하는 테이블.
model training_program_exercise {
  /// 프로그램 운동 구성 내부 PK.
  seq                   Int                  @id @default(autoincrement())
  /// 상위 프로그램 회차 FK.
  program_day_seq       Int
  /// 목표 운동 종목 FK.
  training_category_seq Int
  /// 직접 1RM이 없는 운동에서 목표 중량 계산에 사용할 기준 운동 종목 FK.
  one_rm_reference_category_seq Int?
  /// 회차 안에서 1부터 시작하는 운동 수행 및 표시 순서.
  exercise_order        Int
  /// 목표 세트 수.
  target_sets           Int
  /// 세트당 목표 반복 횟수의 최솟값.
  target_reps_min       Int
  /// 세트당 목표 반복 횟수의 최댓값.
  target_reps_max       Int
  /// 세트 사이의 목표 휴식 시간(초).
  rest_seconds          Int?
  /// 1RM 대비 목표 중량 백분율. 예: 75.00은 75%.
  target_weight_rate    Decimal?             @db.Decimal(5, 2)
  /// 이 운동 구성이 속한 프로그램 회차.
  training_program_day  training_program_day @relation(fields: [program_day_seq], references: [seq], onDelete: Cascade)
  /// 목표 운동 종목.
  training_category     training_category    @relation("ProgramExerciseCategory", fields: [training_category_seq], references: [seq])
  /// 목표 중량 계산에 사용할 기준 1RM 운동 종목.
  one_rm_reference_category training_category? @relation("ProgramExerciseOneRmReference", fields: [one_rm_reference_category_seq], references: [seq])

  @@unique([program_day_seq, exercise_order])
  @@index([training_category_seq])
  @@index([one_rm_reference_category_seq])
}

/// 사용자가 시작한 프로그램 버전과 현재 진행 상태를 관리하는 테이블.
model user_training_program {
  /// 사용자 프로그램 진행 정보 내부 PK.
  seq                Int                          @id @default(autoincrement())
  /// 프로그램을 수행하는 사용자 FK.
  user_seq           Int
  /// 사용자가 시작한 프로그램 버전 FK.
  program_seq        Int
  /// 프로그램의 현재 진행 상태.
  status             user_training_program_status @default(ACTIVE)
  /// 현재 수행할 주차. 1부터 시작한다.
  current_week       Int                          @default(1)
  /// 현재 주차 안에서 수행할 일차. 1부터 시작한다.
  current_day        Int                          @default(1)
  /// 완료 처리된 프로그램 운동 세션 수.
  completed_sessions Int                          @default(0)
  /// 사용자가 프로그램을 시작한 시각.
  started_at         DateTime                     @default(now()) @db.DateTime(0)
  /// 완료 또는 종료된 시각. 진행 중이면 null.
  completed_at       DateTime?                    @db.DateTime(0)
  /// 프로그램을 수행하는 사용자.
  users              users                        @relation(fields: [user_seq], references: [seq])
  /// 사용자가 선택한 프로그램 버전.
  training_program   training_program             @relation(fields: [program_seq], references: [seq])
  /// 이 사용자 프로그램에서 실제로 수행한 운동 세션 목록.
  trainings          training[]

  @@index([user_seq, status])
  @@index([program_seq])
}
